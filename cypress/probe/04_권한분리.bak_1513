// ==========================================================================
// [2.9.7 신규] 04_Depth_소명_권한분리  (조회 전용 — 데이터를 만들거나 바꾸지 않음 → 반복 실행에 영향 없음)
//   소명 문서·경보가 권한 범위 안에서만 보이는지 확인
//     1) 신청자(user014, AI개발2팀)   : 본인 문서만 보임
//     2) 결재자(user001, 부서장)      : user014 문서가 보임 (모든 결재)
//     3) 같은 개발그룹의 다른 팀(user013, AI개발1팀) : user014 의 경보·문서가 보이지 않음 (형제 부서 경계)
//     4) 다른 그룹의 부서장(user010, UI1팀 부서장 / UI/UX그룹) : 결재 권한이 있어도 user014 의 경보·문서가 보이지 않음
//   설계 원칙
//     - 문서가 0건이어도 통과. 「보여야 한다」(2번)는 신청자 화면에 문서가 있을 때만 확인
//     - 조회 기간은 화면 기본값(최근 1개월) 그대로 → 모든 계정이 같은 기간을 봄
//   비밀번호 : cypress.env.json (LC_USER014_PW, LC_HEAD001_PW, LC_USER013_PW, LC_USER010_PW)
// ==========================================================================
const A = require('../../support/anomaly');
const POLICY = 'auto_소명_접속량 과다';
const USER_ID = 'user014';
const HEAD_ID = 'user001';
// 다른 부서 사용자 (.21 관리 > 소속 기준, 2026-11-11 확인 — user010 은 같은 날 UI1팀 부서장으로 지정)
const OTHERS = [
  { id: 'user013', dept: 'AI개발1팀 (같은 개발그룹)', env: 'LC_USER013_PW' },
  { id: 'user010', dept: 'UI1팀 부서장 (UI/UX그룹)', env: 'LC_USER010_PW' }
];
const TAG = `(${USER_ID})`;
const URLS = {
  submit: '/logcatch/approval/submit/anomaly-alerts',
  overview: '/logcatch/approval/document/overview',
  mySubmissions: '/logcatch/approval/document/my-submissions',
  pending: '/logcatch/approval/document/my-pending-approvals'
};
const go = (key) => {
  cy.visit(URLS[key]); cy.wait(3500);
  cy.url().should('include', URLS[key].split('/').pop()); // 권한 없는 화면으로 튕기지 않았는지
};
const search = () => { cy.contains('.v-btn__content, button', '검색').click({ force: true }); cy.wait(2500); };
// Cypress 는 .then 에서 돌려준 DOM 요소 배열을 jQuery 로 바꿔 버림(forEach 없음) → 객체로 감싸서 돌려줌
const docRows = () => cy.get('body').then(($b) => ({ rows: $b.find('tr.ag-row:visible').toArray() }));
const rowsOf = (key) => { go(key); search(); return docRows(); };
const noUser014 = (key, who) => rowsOf(key).then(({ rows }) => {
  const leak = rows.filter((tr) => tr.innerText.includes(TAG)).length;
  cy.log(`${who} · ${key} : 전체 ${rows.length}건 / ${USER_ID} 문서 ${leak}건`);
  expect(leak, `${who} 의 ${key} 에 보이는 ${USER_ID} 문서 수`).to.eq(0);
});

describe('04_Depth_소명_권한분리', () => {
  A.ignoreErrors();

  it('소명 문서·경보는 권한 범위 안에서만 보인다', { retries: 0 }, () => {
    // ---------- 1. 신청자 : 본인 문서만 ----------
    A.login(USER_ID, Cypress.env('LC_USER014_PW'));
    rowsOf('mySubmissions').then(({ rows }) => {
      rows.forEach((tr) => expect(tr.innerText, '신청 결재에는 본인 문서만').to.include(TAG));
      cy.wrap(rows.length).as('ownDocs');
      cy.log(`${USER_ID} 신청 결재 ${rows.length}건`);
    });
    rowsOf('overview').then(({ rows }) =>
      rows.forEach((tr) => expect(tr.innerText, '신청자의 모든 결재에는 본인 관련 문서만').to.include(TAG)));
    rowsOf('pending').then(({ rows }) => expect(rows.length, '신청자(결재 권한 없음)의 담당 결재 건수').to.eq(0));

    // ---------- 2. 결재자(부서장) : 부서원 문서가 보임 ----------
    A.login(HEAD_ID, Cypress.env('LC_HEAD001_PW'));
    rowsOf('overview').then(({ rows }) => {
      const seen = rows.filter((tr) => tr.innerText.includes(TAG)).length;
      cy.log(`${HEAD_ID} 모든 결재 : 전체 ${rows.length}건 / ${USER_ID} 문서 ${seen}건`);
      cy.get('@ownDocs').then((own) => {
        if (own > 0) expect(seen, `부서장에게 보이는 ${USER_ID} 문서 수`).to.be.greaterThan(0);
        else cy.log('ℹ️ 최근 1개월 문서 0건 — 「보여야 한다」 확인은 건너뜀');
      });
    });

    // ---------- 3·4. 다른 부서 사용자·부서장 : 보이지 않음 (부서장은 담당 결재에도 없어야 함) ----------
    OTHERS.forEach(({ id, dept, env }, n) => {
      cy.log(`👤 다른 부서 ${id} — ${dept}`);
      A.login(id, Cypress.env(env));
      go('submit');
      cy.contains('button.sev-filter-btn', /^\s*1년\s*$/).click({ force: true });
      cy.wait(3000);
      cy.get('body').then(($b) => {
        const rows = $b.find('table tbody tr:visible').toArray();
        const leak = rows.filter((tr) => tr.innerText.includes(TAG) || tr.innerText.includes(POLICY)).length;
        cy.log(`${id} 소명 > 신청 : ${rows.length}행 / ${USER_ID}·전용 정책 경보 ${leak}행`);
        expect(leak, `${id}(${dept}) 에게 보이는 ${USER_ID} 경보 수`).to.eq(0);
      });
      A.dumpScreen(`D04P_${n + 3}_${id}_신청`);
      ['overview', 'mySubmissions', 'pending'].forEach((k) => noUser014(k, id));
    });
  });
});
